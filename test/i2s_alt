#include <driver/i2s_std.h>
#include <math.h>

#define I2S_BCLK 4
#define I2S_WS   5
#define I2S_DOUT 7

#define AMP_SD   15

#define SAMPLE_RATE 16000
#define TONE_FREQ 1000

i2s_chan_handle_t tx_handle;

void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println("Starting");

  pinMode(AMP_SD, OUTPUT);
  digitalWrite(AMP_SD, HIGH);

  i2s_chan_config_t chan_cfg =
      I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0,
                                 I2S_ROLE_MASTER);

  ESP_ERROR_CHECK(
      i2s_new_channel(
          &chan_cfg,
          &tx_handle,
          NULL));

  i2s_std_config_t std_cfg = {
      .clk_cfg =
          I2S_STD_CLK_DEFAULT_CONFIG(SAMPLE_RATE),

      .slot_cfg =
          I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(
              I2S_DATA_BIT_WIDTH_16BIT,
              I2S_SLOT_MODE_MONO),

      .gpio_cfg = {
          .mclk = I2S_GPIO_UNUSED,
          .bclk = (gpio_num_t)I2S_BCLK,
          .ws   = (gpio_num_t)I2S_WS,
          .dout = (gpio_num_t)I2S_DOUT,
          .din  = I2S_GPIO_UNUSED,

          .invert_flags = {
              .mclk_inv = false,
              .bclk_inv = false,
              .ws_inv   = false,
          },
      },
  };

  ESP_ERROR_CHECK(
      i2s_channel_init_std_mode(
          tx_handle,
          &std_cfg));

  ESP_ERROR_CHECK(
      i2s_channel_enable(tx_handle));

  Serial.println("I2S READY");
}

float phase = 0;

void loop()
{
  int16_t buffer[256];

  for (int i = 0; i < 256; i++)
  {
    buffer[i] =
        (int16_t)(
            sinf(phase) * 28000);

    phase +=
        2.0f * PI *
        TONE_FREQ /
        SAMPLE_RATE;

    if (phase > 2.0f * PI)
      phase -= 2.0f * PI;
  }

  size_t written;

  i2s_channel_write(
      tx_handle,
      buffer,
      sizeof(buffer),
      &written,
      portMAX_DELAY);
}
