void setup()
{
    Serial.begin(115200);
    delay(2000);

    Serial.println("1");

    pinMode(15, OUTPUT);
    digitalWrite(15, HIGH);

    Serial.println("2");

    Wire.begin(8, 9);

    Serial.println("3");

    Serial.println("Starting I2S");

    Serial.println("4");
}

void loop()
{
    Serial.println("Running");
    delay(1000);
}
